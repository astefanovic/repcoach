{
  "name": "@repcoach/thin-client-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "repcoach": "pnpm --silent --filter @repcoach/dev-server cli",
    "test": "node scripts/run-tests.mjs",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && pnpm --filter @repcoach/web typecheck",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "effect": "4.0.0-beta.78"
  }
}
